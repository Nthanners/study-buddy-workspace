# Copy this to .env and fill in your values
JWT_SECRET=change_this_to_a_long_random_string
AMAI_USERNAME=admin
AMAI_PASSWORD=admin123
PORT=3001
FRONTEND_URL=http://localhost:5173

# Smart lights via Adafruit IO (optional — enables "turn on/off the lights")
# ADAFRUIT_IO_USERNAME = your Adafruit IO username
# ADAFRUIT_IO_KEY      = your Adafruit IO key (Active Key, NOT shared publicly)
# ADAFRUIT_IO_FEED     = the feed KEY (lowercase, usually "lights")
ADAFRUIT_IO_USERNAME=
ADAFRUIT_IO_KEY=
ADAFRUIT_IO_FEED=lights

# AI chat — reliable free small talk via Groq (optional)
# Get a free key at https://console.groq.com/keys  (no credit card)
# GROQ_MODEL defaults to llama-3.1-8b-instant
GROQ_API_KEY=
GROQ_MODEL=llama-3.1-8b-instant
